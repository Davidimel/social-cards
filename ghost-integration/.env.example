# ── Social Cards · Ghost integration config ──
# Copy this file to ".env" and fill in your values.  (.env is gitignored.)

# Port the webhook server listens on
PORT=4747

# Shared secret — Ghost calls /webhook?secret=THIS. Pick any random string.
WEBHOOK_SECRET=change-me-to-something-random

# Your public base URL (your tunnel/domain). Used by `./service.sh url`.
# Leave blank if you haven't set up a public address yet.
PUBLIC_URL=

# Where generated cards are saved. Tip: point this at an iCloud/Dropbox folder
# to sync the cards to your phone automatically. Defaults to ~/SocialCards.
OUTPUT_DIR=

# Which templates / formats to generate ("all", or comma-separated)
#   template indices: 0 Overlay,1 Spotlight,2 Light Card,3 Dark Card,4 Paper,5 Night,6 Headline,7 Quote
#   formats: story,landscape
TEMPLATES=all
FORMATS=all

# Set to false to leave the tagline/excerpt off the cards (title only)
SHOW_TAGLINE=true

# Advanced (usually leave blank — sensible defaults are used):
#   APP_DIR       = the Social Cards app folder (defaults to the parent of this folder)
#   ELECTRON_BIN  = path to electron (defaults to ../node_modules/.bin/electron)
APP_DIR=
ELECTRON_BIN=

# ── Email (optional) ──
EMAIL_ENABLED=false
EMAIL_TO=you@example.com
EMAIL_FROM=you@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
# For Gmail, create an App Password (Google Account → Security → App passwords)
SMTP_PASS=your-app-password
